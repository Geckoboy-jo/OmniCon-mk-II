CXX = main.cpp wrapper.cpp Atari2600.cpp
HXX = top.hpp wrapper.hpp block.hpp Atari2600.hpp
target = OmniCon

$(target):
	g++ -o $(target) $(CXX) -I. -std=c++17 -lSDL2 -ldl
clean:
	rm -f $(target)
save:
	git add .
	git commit -m "save"
	git push
reset:
	make clean
	clear
	make 
	make run
run:
	./$(target)